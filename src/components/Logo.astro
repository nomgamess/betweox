---
import Image from '~/components/common/Image.astro';
import brandLogo from '~/assets/images/betweox-logo.png';
import { SITE } from 'astrowind:config';
---

<a href="/" class="flex items-center self-center ml-2 rtl:ml-0 rtl:mr-2 whitespace-nowrap" aria-label={SITE?.name}>
  <Image src={brandLogo} alt={`${SITE?.name} logo`} width={180} class="h-10 w-auto" format="png" />
</a>
